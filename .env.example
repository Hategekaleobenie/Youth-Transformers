# ==========================================
# Youth Transformers Production Environment Variables
# ==========================================
# Obtain these values from your Firebase Project Console:
# Project Settings -> General -> Your apps -> Web app -> SDK setup and configuration

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=youth-transformers.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=youth-transformers
VITE_FIREBASE_STORAGE_BUCKET=youth-transformers.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# Mode: development | production
VITE_APP_ENV=production
