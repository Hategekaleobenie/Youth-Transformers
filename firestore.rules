rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for real server-side authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isAuthenticated() && getUserData().status == 'active';
    }

    function hasRole(roleName) {
      return isActiveUser() && (getUserData().role == roleName || getUserData().role == 'leader');
    }

    function isLeader() {
      return isActiveUser() && getUserData().role == 'leader';
    }

    // 1. Users collection
    // - Each user can read their own profile
    // - Only Leader can create/update/deactivate users
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isLeader());
      allow create, update, delete: if isLeader();
    }

    // 2. Members collection
    // - Leader & Member Care can write
    // - Authorized leadership roles can read
    match /members/{memberId} {
      allow read: if isActiveUser() && (
        getUserData().role in ['leader', 'member_care', 'level1_leader', 'bible_study']
      );
      allow create, update: if hasRole('member_care');
      allow delete: if isLeader(); // Only leader can permanently delete
    }

    // 3. Pastoral Member Care & Follow-up Cases
    match /followUpCases/{caseId} {
      allow read, write: if hasRole('member_care');
    }

    // 4. Discipleship & Level 1 Records
    match /discipleshipRecords/{recordId} {
      allow read: if isActiveUser();
      allow write: if hasRole('level1_leader');
    }
    match /progressionRecommendations/{recId} {
      allow read: if hasRole('level1_leader');
      allow write: if hasRole('level1_leader');
    }

    // 5. Bible Study & Attendance
    match /bibleStudies/{studyId} {
      allow read: if isActiveUser();
      allow write: if hasRole('bible_study');
    }
    match /attendanceRecords/{attendanceId} {
      allow read: if isActiveUser();
      allow write: if hasRole('bible_study');
    }

    // 6. Finances & Treasury
    // - Strictly restricted to Accountant and Leader
    match /financialTransactions/{txId} {
      allow read, write: if hasRole('accountant');
    }

    // 7. Projects & Equipment
    match /projects/{projectId} {
      allow read: if isActiveUser();
      allow write: if hasRole('projects_manager');
    }
    match /equipment/{equipmentId} {
      allow read: if isActiveUser();
      allow write: if hasRole('projects_manager');
    }

    // 8. Committee Tasks & Reports
    match /committeeTasks/{taskId} {
      allow read: if isActiveUser();
      allow write: if hasRole('committee_coordinator');
    }
    match /committeeReports/{reportId} {
      allow read: if isActiveUser();
      allow write: if hasRole('committee_coordinator');
    }

    // 9. Social Media & Content Calendar
    match /socialPosts/{postId} {
      allow read: if isActiveUser();
      allow write: if hasRole('social_media');
    }
    match /socialInteractions/{interactionId} {
      allow read, write: if hasRole('social_media') || hasRole('member_care');
    }

    // 10. Evangelism & Events
    match /evangelismRecords/{recordId} {
      allow read: if isActiveUser();
      allow write: if isActiveUser() && (getUserData().role in ['leader', 'level1_leader', 'bible_study', 'committee_coordinator']);
    }
    match /ministryEvents/{eventId} {
      allow read: if isActiveUser();
      allow write: if hasRole('committee_coordinator') || hasRole('projects_manager');
    }

    // 11. Announcements
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('committee_coordinator') || hasRole('social_media');
    }

    // 12. Activity Audit Log
    // - Append-only by authenticated operations
    // - Only Leader can view activity logs
    match /activityLogs/{logId} {
      allow read: if isLeader();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }
  }
}
